{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "read-it-later-capture",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "containers": [{ "class_name": "ArticleCaptureContainer", "image": "../Dockerfile.capture", "image_build_context": "..", "max_instances": 1, "instance_type": "basic" }],
  "durable_objects": { "bindings": [{ "name": "CAPTURE_CONTAINER", "class_name": "ArticleCaptureContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArticleCaptureContainer"] }],
  "vars": { "APP_ORIGIN": "http://localhost:8787" },
  "env": {
    "staging": {
      "name": "read-it-later-capture-staging",
      "vars": { "APP_ORIGIN": "https://read-it-later-staging.<account-subdomain>.workers.dev" },
      "containers": [{ "class_name": "ArticleCaptureContainer", "image": "../Dockerfile.capture", "image_build_context": "..", "max_instances": 1, "instance_type": "basic" }],
      "durable_objects": { "bindings": [{ "name": "CAPTURE_CONTAINER", "class_name": "ArticleCaptureContainer" }] }
    },
    "production": {
      "name": "read-it-later-capture-production",
      "vars": { "APP_ORIGIN": "https://read.pajdzik.pl" },
      "containers": [{ "class_name": "ArticleCaptureContainer", "image": "../Dockerfile.capture", "image_build_context": "..", "max_instances": 1, "instance_type": "basic" }],
      "durable_objects": { "bindings": [{ "name": "CAPTURE_CONTAINER", "class_name": "ArticleCaptureContainer" }] }
    }
  }
}
