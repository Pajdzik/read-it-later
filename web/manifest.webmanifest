{
  "id": "/",
  "name": "Potem — reading list",
  "short_name": "Potem",
  "description": "A quiet, private place for the things you want to read later.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f7f2",
  "theme_color": "#f7f7f2",
  "share_target": {
    "action": "/add",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "icons": [
    { "src": "/icons/icon-192.v3.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.v3.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable.v3.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ]
}
