{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "read-it-later",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "vars": {
    "APP_ORIGIN": "https://read.pajdzik.pl",
    "GITHUB_BACKUP_BRANCH": "main",
    "GITHUB_BACKUP_PATH": "Articles",
    "GITHUB_BACKUP_REPOSITORY": "Pajdzik/Kamilpedia",
    "OWNER_GITHUB_ID": "1497744",
    "BACKGROUND_CAPTURE_ENABLED": "false",
    "MANAGED_CONVERSION_ENABLED": "false",
    "ARTICLE_ENRICHMENT_ENABLED": "false",
    "ARTICLE_ENRICHMENT_DAILY_LIMIT": "100"
  },
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/auth",
      "/auth/*",
      "/healthz"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "read-later",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "read-it-later-staging",
      "services": [
        {
          "binding": "ARTICLE_EXTRACTOR",
          "service": "read-it-later-capture-staging"
        }
      ],
      "vars": {
        "APP_ORIGIN": "https://read-it-later-staging.<account-subdomain>.workers.dev",
        "OWNER_GITHUB_ID": "replace-with-numeric-github-user-id",
        "BACKGROUND_CAPTURE_ENABLED": "false",
        "MANAGED_CONVERSION_ENABLED": "false",
        "ARTICLE_ENRICHMENT_ENABLED": "false",
        "ARTICLE_ENRICHMENT_DAILY_LIMIT": "100"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "read-later-staging-v1",
          "database_id": "replace-with-fresh-staging-d1-database-id",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": [
          "0 * * * *"
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "EXTRACTION_QUEUE",
            "queue": "read-it-later-extraction-staging"
          }
        ],
        "consumers": [
          {
            "queue": "read-it-later-extraction-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_concurrency": 1,
            "max_retries": 10,
            "retry_delay": 60
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "PDF_BUCKET",
          "bucket_name": "read-it-later-pdfs-staging"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    },
    "production": {
      "name": "read-it-later-production",
      "services": [
        {
          "binding": "ARTICLE_EXTRACTOR",
          "service": "read-it-later-capture-production"
        }
      ],
      "vars": {
        "APP_ORIGIN": "https://read.pajdzik.pl",
        "OWNER_GITHUB_ID": "1497744",
        "GITHUB_BACKUP_REPOSITORY": "Pajdzik/Kamilpedia",
        "GITHUB_BACKUP_BRANCH": "main",
        "GITHUB_BACKUP_PATH": "Articles",
        "BACKGROUND_CAPTURE_ENABLED": "false",
        "MANAGED_CONVERSION_ENABLED": "false",
        "ARTICLE_ENRICHMENT_ENABLED": "false",
        "ARTICLE_ENRICHMENT_DAILY_LIMIT": "100"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "read-later-production-v1",
          "database_id": "replace-with-fresh-production-d1-database-id",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": [
          "0 * * * *"
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "EXTRACTION_QUEUE",
            "queue": "read-it-later-extraction-production"
          }
        ],
        "consumers": [
          {
            "queue": "read-it-later-extraction-production",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_concurrency": 1,
            "max_retries": 10,
            "retry_delay": 60
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "PDF_BUCKET",
          "bucket_name": "read-it-later-pdfs-production"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "EXTRACTION_QUEUE",
        "queue": "read-it-later-extraction"
      }
    ],
    "consumers": [
      {
        "queue": "read-it-later-extraction",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 60
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    },
    "redact_query_string": true
  },
  "r2_buckets": [
    {
      "binding": "PDF_BUCKET",
      "bucket_name": "read-it-later-pdfs-local"
    }
  ]
}
