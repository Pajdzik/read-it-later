{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "read-it-later",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/auth",
      "/auth/*",
      "/healthz"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "read-later",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "read-it-later-staging",
      "vars": {
        "APP_ORIGIN": "https://read-it-later-staging.<account-subdomain>.workers.dev",
        "OWNER_GITHUB_ID": "replace-with-numeric-github-user-id"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "read-later-staging",
          "database_id": "11111111-1111-4111-8111-111111111111",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "read-it-later-production",
      "vars": {
        "APP_ORIGIN": "https://read-it-later-production.<account-subdomain>.workers.dev",
        "OWNER_GITHUB_ID": "replace-with-numeric-github-user-id"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "read-later-production",
          "database_id": "22222222-2222-4222-8222-222222222222",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
