{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "read-it-later-safe-fetch",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0 }
  },
  "vars": {
    "APP_ORIGIN": "https://read.pajdzik.pl"
  },
  "containers": [
    {
      "class_name": "ArticleFetchContainer",
      "name": "read-it-later-safe-fetch",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "FETCH_CONTAINER", "class_name": "ArticleFetchContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ArticleFetchContainer"] }
  ],
  "env": {
    "staging": {
      "name": "read-it-later-safe-fetch-staging",
      "vars": { "APP_ORIGIN": "https://read-it-later-staging.<account-subdomain>.workers.dev" },
      "containers": [
        { "name": "read-it-later-safe-fetch-staging", "class_name": "ArticleFetchContainer", "image": "./Dockerfile", "max_instances": 1, "instance_type": "lite" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "FETCH_CONTAINER", "class_name": "ArticleFetchContainer" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArticleFetchContainer"] }]
    },
    "production": {
      "name": "read-it-later-safe-fetch-production",
      "vars": { "APP_ORIGIN": "https://read.pajdzik.pl" },
      "containers": [
        { "name": "read-it-later-safe-fetch-production", "class_name": "ArticleFetchContainer", "image": "./Dockerfile", "max_instances": 1, "instance_type": "lite" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "FETCH_CONTAINER", "class_name": "ArticleFetchContainer" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArticleFetchContainer"] }]
    }
  }
}
