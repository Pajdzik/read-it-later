{
  "name": "read-it-later",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "pnpm build:prototype && node dist/prototype/server.mjs",
    "check": "pnpm typecheck",
    "dev": "pnpm build:web && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p web/tsconfig.sw.json && tsc --noEmit -p public/tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p extension/tsconfig.json && tsc --noEmit -p benchmarks/tsconfig.json",
    "build": "pnpm build:web && pnpm build:prototype && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --dry-run --env=\"\" --outdir dist/worker",
    "test": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run",
    "db:migrate:local": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler d1 migrations apply read-later --local",
    "db:migrate:remote": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler d1 migrations apply read-later --remote",
    "build:web": "tsx scripts/build-web.ts",
    "build:extension": "tsx scripts/build-extension.ts",
    "test:extension:chromium": "pnpm build:extension && node scripts/extension-chromium-smoke.mjs",
    "test:extension": "pnpm test:extension:chromium && node scripts/extension-e2e.mjs",
    "test:browser": "node --import tsx scripts/browser-smoke.mjs",
    "test:mobile": "node --import tsx scripts/mobile-smoke.mjs",
    "archive:rehearse": "tsx scripts/archive-rehearsal.ts",
    "test:archive": "node --import tsx --test scripts/archive-backup.test.mjs scripts/backup-migrate.test.mjs && tsx scripts/archive-rehearsal.ts",
    "backup:migrate": "tsx scripts/backup-migrate.ts",
    "test:backup-migrate": "node --import tsx --test scripts/backup-migrate.test.mjs",
    "obsidian:convert": "tsx scripts/obsidian-convert.ts",
    "obsidian:integration": "node --import tsx scripts/obsidian-integration.mjs",
    "test:obsidian": "node --import tsx --test scripts/obsidian-convert.test.mjs && node --import tsx scripts/obsidian-integration.mjs",
    "github:convert": "tsx scripts/github-convert.ts",
    "github:integration": "node --import tsx scripts/github-integration.mjs",
    "test:github": "node --import tsx --test scripts/github-convert.test.mjs && node --import tsx scripts/github-integration.mjs",
    "build:prototype": "tsx scripts/build-prototype.ts",
    "test:prototype": "pnpm build:prototype && node scripts/prototype-smoke.mjs",
    "benchmark:deploy": "tsx scripts/deploy-extraction-benchmark.ts",
    "benchmark:extraction": "tsx scripts/benchmark-extraction.ts",
    "build:benchmark": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --config benchmarks/wrangler.jsonc --dry-run --outdir dist/extraction-benchmark"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.4",
    "@cloudflare/workers-types": "5.20260930.2",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.4",
    "esbuild": "0.28.1",
    "playwright": "1.62.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  },
  "dependencies": {
    "defuddle": "0.19.4",
    "dompurify": "3.4.16",
    "linkedom": "0.18.13",
    "markdown-it": "15.0.3",
    "yaml": "2.8.3"
  }
}
