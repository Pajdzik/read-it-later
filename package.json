{
  "name": "read-it-later",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "pnpm dev",
    "check": "pnpm typecheck",
    "dev": "pnpm build:web && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p web/tsconfig.sw.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p extension/tsconfig.json && tsc --noEmit -p benchmarks/tsconfig.json && tsc --noEmit -p capture/tsconfig.json",
    "typecheck:fetcher": "tsc --noEmit -p fetcher/tsconfig.json && tsc --noEmit -p probes/edge-pinned-fetch/tsconfig.json",
    "types:fetcher": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types fetcher/bindings.d.ts --config fetcher/wrangler.jsonc --env-interface ArticleFetcherBindings --include-runtime=false --strict-vars=false",
    "build": "pnpm build:web && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --dry-run --env=\"\" --outdir dist/worker",
    "build:fetch-probe": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --dry-run --outdir .wrangler/fetch-probe-dry-run --config probes/edge-pinned-fetch/wrangler.jsonc",
    "test:fetcher": "NODE_ENV=test node --import tsx --test fetcher/test/*.test.ts",
    "test:capture-deployment": "node --import tsx --test scripts/capture-deployment.test.ts",
    "build:capture": "tsx scripts/build-capture.ts",
    "test:capture": "pnpm build:capture && node --import tsx --test capture/tests/*.test.ts",
    "check:capture": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --config capture/wrangler.jsonc --env staging --dry-run --outdir dist/capture-worker",
    "capture:deploy": "tsx scripts/deploy-capture-stack.ts",
    "build:fetcher": "esbuild fetcher/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=fetcher/dist/server.mjs",
    "build:fetcher-dry-run": "pnpm build:fetcher && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --dry-run --containers-rollout=none --env=\"\" --outdir .wrangler/fetcher-dry-run --config fetcher/wrangler.jsonc",
    "test:fetcher:container": "pnpm build:fetcher && node scripts/fetcher-container-smoke.mjs",
    "test": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run",
    "db:migrate:local": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler d1 migrations apply read-later --local",
    "db:migrate:remote": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler d1 migrations apply read-later --remote",
    "build:web": "tsx scripts/build-web.ts",
    "build:extension": "tsx scripts/build-extension.ts",
    "test:extension:chromium": "pnpm build:extension && node scripts/extension-chromium-smoke.mjs",
    "test:extension": "pnpm test:extension:chromium && node scripts/extension-e2e.mjs",
    "test:browser": "node --import tsx scripts/browser-smoke.mjs",
    "test:mobile": "node --import tsx scripts/mobile-smoke.mjs",
    "archive:rehearse": "tsx scripts/archive-rehearsal.ts",
    "test:archive": "node --import tsx --test scripts/archive-backup.test.mjs scripts/backup-migrate.test.mjs && tsx scripts/archive-rehearsal.ts",
    "backup:migrate": "tsx scripts/backup-migrate.ts",
    "test:backup-migrate": "node --import tsx --test scripts/backup-migrate.test.mjs",
    "obsidian:convert": "tsx scripts/obsidian-convert.ts",
    "obsidian:integration": "node --import tsx scripts/obsidian-integration.mjs",
    "test:obsidian": "node --import tsx --test scripts/obsidian-convert.test.mjs && node --import tsx scripts/obsidian-integration.mjs",
    "github:convert": "tsx scripts/github-convert.ts",
    "github:integration": "node --import tsx scripts/github-integration.mjs",
    "test:github": "node --import tsx --test scripts/github-convert.test.mjs && node --import tsx scripts/github-integration.mjs",
    "benchmark:deploy": "tsx scripts/deploy-extraction-benchmark.ts",
    "benchmark:extraction": "tsx scripts/benchmark-extraction.ts",
    "build:benchmark": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --config benchmarks/wrangler.jsonc --dry-run --outdir dist/extraction-benchmark"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.4",
    "@cloudflare/workers-types": "5.20260930.2",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.4",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "playwright": "1.62.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "defuddle": "0.19.4",
    "dompurify": "3.4.17",
    "linkedom": "0.18.13",
    "markdown-it": "15.0.3",
    "yaml": "2.8.3",
    "ipaddr.js": "2.5.0"
  }
}
