# Use a different random 32+ byte token for each deployment. Configure the same
# value as the ARTICLE_FETCHER_TOKEN secret on the private adapter Worker.
ARTICLE_FETCHER_TOKEN=replace-with-at-least-32-random-bytes
APP_ORIGIN=https://your-production-worker.example
# Include every exact hostname that routes to this app and gateway; comma-separated.
BLOCKED_HOSTS=your-production-worker.example,your-staging-worker.example,article-fetch-gateway.internal
PORT=8080
